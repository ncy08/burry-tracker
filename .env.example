# Google Sheet that receives the five output tabs.
BURRY_TRACKER=YOUR_SPREADSHEET_ID

# Gmail label and sender filter for incoming Substack posts.
SUBSTACK_GMAIL_LABEL=trading-alerts
SUBSTACK_GMAIL_SENDER=michaeljburry@substack.com

# Gemini API key (either name works).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google OAuth desktop-app client. Alternative: put client_secrets.json
# at ~/.substack-trader/client_secrets.json instead.
GOOGLE_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

# Rebalance engine (all optional).
RISK_MULTIPLIER=1.0
MIN_REBALANCE_USD=100
# USER_PORTFOLIO_CSV_PATH=~/.substack-trader/user_portfolio.csv

# Twilio SMS alerts (optional; SMS is skipped when unset).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Optional: path to a headless-browser CLI for the one-time archive backfill.
# BROWSE_BIN=/path/to/browse
